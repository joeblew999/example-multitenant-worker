# Default demo scenario. Picks DevAccounts list (src/seed-scenarios/<name>.ts)
# AND the canonical theme (index.html data-theme attribute) AND the backend
# seed (scripts/seed/scenario.<name>.mjs).
#
# Override per-build with: VITE_SEED_SCENARIO=remysport pnpm dev
# Override per-deploy in CI / wrangler config.
VITE_SEED_SCENARIO=editorial
